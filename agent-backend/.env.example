# Leave empty to run in demo mode (rule-based, no LLM): search and highlight still work.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# The Next.js app serves the simulated device platform under /api
PLATFORM_URL=http://localhost:3000
# Comma-separated origins allowed to call the agent directly (the web app normally proxies)
CORS_ORIGINS=http://localhost:3000
