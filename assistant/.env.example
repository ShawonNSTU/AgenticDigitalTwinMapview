# --- LLM (Ollama) ---
# PLACEHOLDER: the model you pulled on your Ollama server, and that server's URL (host:11434).
OLLAMA_MODEL=qwen3.5:35b
OLLAMA_BASE_URL=http://YOUR-OLLAMA-HOST:11434
# Only for an Ollama behind an authenticating proxy
OLLAMA_API_KEY=
# Keep the model loaded between chats (5m, 1h, -1 = forever)
OLLAMA_KEEP_ALIVE=30m
# gpt-oss: low|medium|high. Qwen and other thinking models: true|false (false = faster). Empty = model default.
OLLAMA_THINK=false
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0
LLM_STRUCTURED_OUTPUT=true
LLM_MAX_RETRIES=2

# --- SmartThings ---
# The digital twin's SmartThings-compatible API (web app). Standalone: https://api.smartthings.com/v1/devices
IOT_API_BASE_URL=http://localhost:3000/api/st/v1/devices
# Fallback token when the request has no "Authorization: Bearer ..." header
IOT_API_BEARER_TOKEN=
ST_TIMEOUT_S=15
# true = don't send commands to SmartThings, just log them (status reads stay live)
ST_DRY_RUN=false

# Turns at once / longest a whole turn may take (s)
MAX_CONCURRENT_TURNS=4
TURN_TIMEOUT_S=90
# Staff-only skill: find devices by health and explain faults (needs the twin API next to IOT_API_BASE_URL)
DIAGNOSTICS_ENABLED=true

# --- Prompt budget ---
HISTORY_MAX_MESSAGES=6
HISTORY_MAX_CHARS=300
MAX_DEVICE_CANDIDATES=25
# Most devices one status answer reads live
MAX_STATUS_DEVICES=15

# --- Behaviour ---
BOT_NAME=SmartThingsBot
# template (deterministic) | llm (model phrases the confirmation)
REPLY_STYLE=template
# Comma separated; empty = all skills
ENABLED_SKILLS=
LOCATION_SKILL_ENABLED=false
LOCATION_DATA_PATH=data/locations.json
ROOMS_DATA_PATH=data/rooms.json

# --- Server ---
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO
