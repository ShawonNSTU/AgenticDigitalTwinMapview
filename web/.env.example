
# SmartThings access token: links the SmartThings Experience Zone's 13 real devices (docs/smartthings-zone-devices.md)
# and controls them from the map. Keep it here in web/.env only (gitignored), never in docs/.
SMARTTHINGS_TOKEN=
# How often the real devices' status is read, in ms (default 2000)
SMARTTHINGS_POLL_MS=2000

# The assistant (assistant/, Ollama): the one chat for administrator, technician and guest.
# Ollama itself (OLLAMA_BASE_URL, OLLAMA_MODEL) is set in assistant/.env
ASSISTANT_URL=http://localhost:8100

# Time zone used when the assistant tells times from the journal (e.g. Asia/Dhaka); empty = the server's
TWIN_TIMEZONE=Asia/Dhaka

# Energy view: the hotel's tariff and the grid's carbon factor (also editable with PATCH /api/energy)
ENERGY_TARIFF_PER_KWH=0.15
ENERGY_CURRENCY=USD
GRID_CO2_KG_PER_KWH=0.45
# A "Degrading" simulated fault reaches full severity over this many minutes (its failure can be predicted)
DEGRADE_MINUTES=6
